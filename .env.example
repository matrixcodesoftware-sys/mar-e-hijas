# =====================================================================
#  MAR E HIJAS — Variables de entorno
#  Copiá este archivo como .env y completá los valores. NUNCA subas .env
#  a un repositorio.
# =====================================================================

# development | production
FLASK_ENV=development

# Clave para firmar sesiones y tokens CSRF. En producción usá una larga y aleatoria:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# --- Base de datos MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mar_e_hijas
DB_USER=root
DB_PASSWORD=

# Zona horaria del negocio (fechas de ventas, caja, reportes)
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Registros por página en listados
ITEMS_POR_PAGINA=25

# Minutos de inactividad antes de cerrar la sesión
SESION_MINUTOS=480

# Poner en 1 cuando se sirva por HTTPS (cookies "Secure")
SESSION_COOKIE_SECURE=0

# --- Facturación electrónica (ARCA/AFIP) ---
# "ninguno" hasta implementar el proveedor oficial (ver docs/ARQUITECTURA.md §12)
FACTURACION_PROVEEDOR=ninguno
ARCA_CERT_PATH=
ARCA_KEY_PATH=
ARCA_PRODUCCION=0
